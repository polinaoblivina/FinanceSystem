<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.Development.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="9.0.20" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.20" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.20" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FinanceSystem.Application\FinanceSystem.Application.csproj" />
    <ProjectReference Include="..\FInanceSystem.Domain\FInanceSystem.Domain.csproj" />
    <ProjectReference Include="..\FinancialSystem.Infrastructure\FinanceSystem.Infrastructure.csproj" />
  </ItemGroup>

</Project>
